# --- Gateway auth (Claude Desktop -> Gateway) ---
# Static bearer token Desktop must present. Set "Credential kind" = token in the UI.
GATEWAY_AUTH_TOKEN=change-me-to-a-long-random-string

# --- AWS / Bedrock (Gateway -> Bedrock) ---
AWS_REGION=us-east-1
# Local dev: an AWS profile works via the default chain.
AWS_PROFILE=your-aws-profile
# Prod / IAM role: assume this role for Bedrock calls (leave blank to use the
# task/instance role or the default chain above).
GATEWAY_ASSUME_ROLE_ARN=

# --- Routing ---
# When true, requests for the fleet default model (claude-fable-5) are routed as
# `auto` — the "user never changed the default" scenario. Off = respect the
# picked model unless the user selects claude-auto or sends x-routing-mode.
ROUTER_INTERCEPT_DEFAULT=false
